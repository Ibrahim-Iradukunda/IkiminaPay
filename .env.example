# Copy this file to .env and fill in real values. Never commit .env.
# All values below are fake placeholders.

# Port the Express server listens on
PORT=3000

# PostgreSQL connection (local Docker values shown; production uses the RDS endpoint)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ikiminapay
DB_USER=ikiminapay_user
DB_PASSWORD=change-me-local-password

# SSL is on unless this is false. Use false for local PostgreSQL; leave unset or true for AWS RDS
DB_SSL=false
# Optional path to the RDS CA bundle (default: certs/eu-north-1-bundle.pem if it exists)
DB_SSL_CA=

# Optional: how many times to retry connecting to the database at startup
DB_CONNECT_RETRIES=5
