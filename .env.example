# Copy this file to .env and fill in real values. Never commit .env.
# All values below are fake placeholders.

# Port the Express server listens on
PORT=3000

# Local PostgreSQL connection. In production, Ansible fetches the real
# credentials from AWS Secrets Manager into /opt/ikiminapay/.env on the app VM.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ikiminapay
DB_USER=ikiminapay_user
DB_PASSWORD=change-me-local-password

# SSL is on unless this is false. Use false for local PostgreSQL; leave unset or true for AWS RDS
DB_SSL=false
# Optional path to the RDS CA bundle (default: certs/eu-north-1-bundle.pem if it exists)
DB_SSL_CA=

# Optional: how many times to retry connecting to the database at startup
DB_CONNECT_RETRIES=5

# Used only by the local postgres service in docker-compose.yml.
# Must match DB_NAME, DB_USER and DB_PASSWORD above.
POSTGRES_DB=ikiminapay
POSTGRES_USER=ikiminapay_user
POSTGRES_PASSWORD=change-me-local-password
